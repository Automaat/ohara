{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "reviewers": ["Automaat"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track pinned nilaway pseudo-version in scripts/run-nilaway.sh",
      "fileMatch": ["^scripts/run-nilaway\\.sh$"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+NILAWAY_VERSION=\"(?<currentValue>.+?)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group the Svelte / Vite / Vitest toolchain",
      "groupName": "svelte toolchain",
      "matchPackageNames": ["/^svelte/", "/^@sveltejs\\//", "/^vite/", "/^@vitest\\//"]
    },
    {
      "description": "CI (go.mod toolchain), the image (Dockerfile golang tag) and local dev (.mise.toml) use one Go patch release, so bump them in one PR",
      "groupName": "go",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "matchDepNames": ["go"]
    },
    {
      "description": "See the go group above",
      "groupName": "go",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"]
    },
    {
      "description": "See the go group above",
      "groupName": "go",
      "matchManagers": ["mise"],
      "matchDepNames": ["go"]
    },
    {
      "description": "Production runs Postgres 18 (home-nas ohara stack), so a Postgres major waits for a person to upgrade production first",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["postgres"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
